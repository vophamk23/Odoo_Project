<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Search View -->
    <record id="tutorial_view_search_game" model="ir.ui.view">
        <field name="name">Game Search</field>
        <field name="model">tutorial.game</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="developer_id"/>
                <filter string="Đã Phát Hành" name="released" domain="[('state', '=', 'released')]"/>
                <filter string="Multiplayer" name="multiplayer" domain="[('is_multiplayer', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Nhà Phát Triển" name="group_developer" context="{'group_by':'developer_id'}"/>
                    <filter string="Trạng Thái" name="group_state" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Tree View -->
    <record id="tutorial_view_tree_game" model="ir.ui.view">
        <field name="name">Game List</field>
        <field name="model">tutorial.game</field>
        <field name="arch" type="xml">
            <tree decoration-info="state == 'draft'" decoration-success="state == 'released'">
                <field name="name"/>
                <field name="developer_id"/>
                <field name="price"/>
                <field name="release_date"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'released'" decoration-warning="state == 'upcoming'" decoration-danger="state == 'discontinued'"/>
            </tree>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="tutorial_view_kanban_game" model="ir.ui.view">
        <field name="name">Game Kanban</field>
        <field name="model">tutorial.game</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_mobile">
                <field name="id"/>
                <field name="name"/>
                <field name="image"/>
                <field name="price"/>
                <field name="rating"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <img t-att-src="kanban_image('tutorial.game', 'image', record.id.raw_value)" alt="Game Cover" class="o_image_64_contain"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div t-if="record.developer_id.value">
                                    <field name="developer_id"/>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="price" widget="monetary"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="rating" widget="priority"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Form View -->
    <record id="tutorial_view_form_game" model="ir.ui.view">
        <field name="name">Game Form</field>
        <field name="model">tutorial.game</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,upcoming,released"/>
                </header>
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Tên Game..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="developer_id"/>
                            <field name="release_date"/>
                        </group>
                        <group>
                            <field name="price"/>
                            <field name="rating" widget="priority"/>
                            <field name="is_multiplayer"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Mô Tả Chi Tiết" name="description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
