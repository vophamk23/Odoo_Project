<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action cho Transaction (đặt ở trên để form có thể refer) -->
    <record id="action_bank_transaction" model="ir.actions.act_window">
        <field name="name">Giao dịch</field>
        <field name="res_model">bank.transaction</field>
        <field name="view_mode">tree,form,graph</field>
    </record>

    <!-- List View cho Account -->
    <record id="view_bank_account_list" model="ir.ui.view">
        <field name="name">bank.account.list</field>
        <field name="model">bank.account</field>
        <field name="arch" type="xml">
            <tree string="Tài khoản Ngân hàng">
                <field name="account_number"/>
                <field name="customer_name"/>
                <field name="account_type"/>
                <field name="balance" sum="Tổng số dư"/>
                <field name="currency_id" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- Kanban View (Giao diện thẻ) cho Account -->
    <record id="view_bank_account_kanban" model="ir.ui.view">
        <field name="name">bank.account.kanban</field>
        <field name="model">bank.account</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="account_number"/>
                <field name="customer_name"/>
                <field name="balance"/>
                <field name="account_type"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click o_kanban_record_has_image_fill o_bank_management_kanban {{record.account_type.raw_value == 'savings' ? 'oe_kanban_color_2' : 'oe_kanban_color_5'}}">
                            <div class="oe_kanban_details" style="padding: 15px; border-radius: 10px; background: linear-gradient(135deg, #fdfbfb 0%, #ebedee 100%); box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
                                <strong class="o_kanban_record_title" style="font-size: 18px; color: #333;">
                                    <i class="fa fa-credit-card mr-2" title="Thẻ" aria-label="Thẻ"/> <field name="customer_name"/>
                                </strong>
                                <div class="o_kanban_tags_section mt-2">
                                    <span class="badge rounded-pill text-bg-primary" t-if="record.account_type.raw_value == 'checking'">Thanh toán</span>
                                    <span class="badge rounded-pill text-bg-success" t-if="record.account_type.raw_value == 'savings'">Tiết kiệm</span>
                                </div>
                                <div style="margin-top: 15px; font-family: monospace; font-size: 16px; letter-spacing: 2px;">
                                    <field name="account_number"/>
                                </div>
                                <div style="margin-top: 10px; font-size: 20px; font-weight: bold; color: #2c3e50; text-align: right;">
                                    <field name="balance" widget="monetary"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Form View cho Account -->
    <record id="view_bank_account_form" model="ir.ui.view">
        <field name="name">bank.account.form</field>
        <field name="model">bank.account</field>
        <field name="arch" type="xml">
            <form string="Tài khoản Ngân hàng">
                <sheet>
                    <!-- Smart Button -->
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_bank_transaction)d" type="action" class="oe_stat_button" icon="fa-exchange" context="{'search_default_account_id': id, 'default_account_id': id}">
                            <field name="transaction_count" widget="statinfo" string="Giao dịch"/>
                        </button>
                    </div>
                    
                    <div class="oe_title">
                        <h1>
                            <field name="customer_name" placeholder="Tên Chủ thẻ"/>
                        </h1>
                        <h2>
                            <field name="account_number" placeholder="Số tài khoản"/>
                        </h2>
                    </div>
                    
                    <group>
                        <group>
                            <field name="account_type"/>
                        </group>
                        <group>
                            <field name="balance" style="font-size: 24px; font-weight: bold; color: green;"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Lịch sử Giao dịch">
                            <field name="transaction_ids" readonly="1">
                                <tree decoration-success="type=='deposit'" decoration-danger="type=='withdraw'">
                                    <field name="date"/>
                                    <field name="name"/>
                                    <field name="type"/>
                                    <field name="amount" sum="Tổng"/>
                                    <field name="state" widget="badge" decoration-success="state=='done'" decoration-info="state=='draft'" decoration-danger="state=='cancelled'"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action & Menus -->
    <record id="action_bank_account" model="ir.actions.act_window">
        <field name="name">Tài khoản Ngân hàng</field>
        <field name="res_model">bank.account</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>

    <!-- Root Menu -->
    <menuitem id="menu_bank_root" name="Ngân hàng (Premium)" web_icon="bank_management,static/description/icon.png" sequence="10"/>
    
    <menuitem id="menu_bank_account" name="Tài khoản" parent="menu_bank_root" action="action_bank_account" sequence="10"/>
</odoo>
