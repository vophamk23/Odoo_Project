<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="cmcts_homepage_layout" inherit_id="website.layout" name="CMCTS Layout Assets">
        <xpath expr="//head" position="inside">
            <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&amp;display=swap" rel="stylesheet"/>
        </xpath>
    </template>

    <template id="cmcts_homepage" inherit_id="website.homepage" name="CMCTS Homepage SaaS">
        <xpath expr="//div[@id='wrap']" position="replace">
            
            <div id="wrap" class="oe_structure oe_empty">
                <!-- Hide default header and footer -->
                <t t-set="no_header" t-value="True"/>
                <t t-set="no_footer" t-value="True"/>
                
                <!-- Glassmorphism Navbar -->
                <nav class="cmcts-navbar">
                    <div class="container d-flex justify-content-between align-items-center">
                        <a href="/" class="d-flex align-items-center text-decoration-none">
                            <img src="/cmcts_website/static/src/img/cmcts_logo.png" alt="CMCTS Logo" class="cmcts-logo-img me-2"/>
                        </a>
                        <div>
                            <a href="#consulting-form" class="cmcts-nav-btn">Tư Vấn Ngay</a>
                        </div>
                    </div>
                </nav>

                <!-- Hero Section (Mesh Gradient + Typography) -->
                <section class="cmcts-hero">
                    <div class="cmcts-hero-mesh"></div>
                    <div class="container">
                        <div class="row justify-content-center">
                            <div class="col-lg-10 text-center">
                                <span class="cmcts-hero-badge">Odoo Enterprise Solution</span>
                                <h1>Xây Dựng Khung Gầm Vững Chắc<br/>Cho Doanh Nghiệp Số</h1>
                                <p class="lead">
                                    Nền tảng quản lý hợp nhất. Xóa bỏ ranh giới giữa Kho bãi và Chăm sóc khách hàng.
                                    Tự động hóa toàn diện quy trình với CMCTS ERP.
                                </p>
                                <a href="#consulting-form" class="cmcts-btn-primary mt-3">
                                    Bắt đầu chuyển đổi ngay
                                    <i class="fa fa-arrow-right ms-2"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Bento Grid Services Section -->
                <section class="cmcts-bento-section">
                    <div class="container">
                        <div class="row justify-content-center mb-5">
                            <div class="col-lg-8 text-center">
                                <h2 class="fw-bold" style="font-size: 2.5rem; letter-spacing: -0.02em; color: var(--primary);">Hệ sinh thái duy nhất<br/>mà bạn cần</h2>
                            </div>
                        </div>
                        
                        <!-- Bento Grid -->
                        <div class="row g-4">
                            <!-- Large Card 1 -->
                            <div class="col-lg-8">
                                <div class="cmcts-bento-card bento-large">
                                    <div class="cmcts-bento-icon">
                                        <i class="fa fa-qrcode"></i>
                                    </div>
                                    <h3 class="cmcts-bento-title">Kiểm soát Serial Number Tuyệt Đối</h3>
                                    <p class="cmcts-bento-desc w-75">
                                        Hệ thống bắt buộc truy xuất nguồn gốc từng sản phẩm. Chặn đứng lỗi sai lệch tồn kho với cơ chế xác thực Serial tự động trước khi xuất hàng.
                                    </p>
                                </div>
                            </div>
                            
                            <!-- Small Card 1 -->
                            <div class="col-lg-4">
                                <div class="cmcts-bento-card text-center d-flex flex-column align-items-center justify-content-center" style="background: var(--primary); color: white; border: none;">
                                    <i class="fa fa-bolt mb-3" style="font-size: 48px; color: #f59e0b;"></i>
                                    <h4 class="fw-bold mb-0">Tự Động Hóa 100%</h4>
                                </div>
                            </div>

                            <!-- Small Card 2 -->
                            <div class="col-lg-4">
                                <div class="cmcts-bento-card">
                                    <div class="cmcts-bento-icon" style="color: var(--accent);">
                                        <i class="fa fa-envelope-open-text"></i>
                                    </div>
                                    <h4 class="cmcts-bento-title">Email Báo Giá</h4>
                                    <p class="cmcts-bento-desc">
                                        Tự động gửi báo giá chuyên nghiệp ngay khi khách hàng bước vào giai đoạn đàm phán.
                                    </p>
                                </div>
                            </div>

                            <!-- Large Card 2 -->
                            <div class="col-lg-8">
                                <div class="cmcts-bento-card bento-large">
                                    <div class="cmcts-bento-icon" style="color: var(--secondary);">
                                        <i class="fa fa-users-cog"></i>
                                    </div>
                                    <h3 class="cmcts-bento-title">CRM Pipeline Tiên Tiến</h3>
                                    <p class="cmcts-bento-desc w-75">
                                        Thu thập Lead trực tiếp từ Website. Hệ thống tự động tạo Lịch nhắc nhở gọi điện (Activity) cho Sales Manager ngay khi có cơ hội mới.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Split Screen Form Section -->
                <section id="consulting-form" class="cmcts-split-section">
                    <div class="col-lg-5 cmcts-split-left">
                        <h2 class="display-5 fw-bold mb-4">Bạn đã sẵn sàng<br/>tăng tốc?</h2>
                        <p class="fs-5" style="color: #cbd5e1;">Liên hệ với chuyên gia của chúng tôi để được tư vấn lộ trình triển khai ERP hoàn toàn miễn phí.</p>
                        
                        <ul class="cmcts-trust-list">
                            <li><i class="fa fa-check-circle"></i> Triển khai nhanh gọn trong 2 tuần</li>
                            <li><i class="fa fa-check-circle"></i> Miễn phí tư vấn quy trình kho</li>
                            <li><i class="fa fa-check-circle"></i> Đội ngũ kỹ sư hỗ trợ 24/7</li>
                        </ul>
                    </div>
                    
                    <div class="col-lg-7 cmcts-split-right">
                        <div style="max-width: 500px; width: 100%; margin: 0 auto;">
                            <h3 class="fw-bold mb-4" style="color: var(--primary);">Đăng ký tư vấn</h3>
                            <form action="/tu-van" method="post" enctype="multipart/form-data">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                
                                <div class="row">
                                    <div class="col-md-6 cmcts-form-group">
                                        <label class="cmcts-form-label">Họ và Tên</label>
                                        <input type="text" class="cmcts-input" name="name" placeholder="Ví dụ: Nguyễn Văn A" required="required"/>
                                    </div>
                                    <div class="col-md-6 cmcts-form-group">
                                        <label class="cmcts-form-label">Số điện thoại</label>
                                        <input type="tel" class="cmcts-input" name="phone" placeholder="090 123 4567" required="required"/>
                                    </div>
                                </div>
                                
                                <div class="cmcts-form-group">
                                    <label class="cmcts-form-label">Email làm việc</label>
                                    <input type="email" class="cmcts-input" name="email" placeholder="email@congty.com" required="required"/>
                                </div>
                                
                                <div class="cmcts-form-group">
                                    <label class="cmcts-form-label">Nhu cầu triển khai</label>
                                    <textarea class="cmcts-input" name="description" placeholder="Vui lòng chia sẻ ngắn gọn về bài toán quản lý kho/bán hàng của bạn..." style="height: 120px; resize: none;"></textarea>
                                </div>
                                
                                <button type="submit" class="cmcts-btn-primary w-100">Gửi Yêu Cầu</button>
                                <p class="text-center text-muted mt-3" style="font-size: 13px;">Bằng cách gửi yêu cầu, bạn đồng ý với chính sách bảo mật của chúng tôi.</p>
                            </form>
                        </div>
                    </div>
                </section>

            </div>
        </xpath>
    </template>
</odoo>
