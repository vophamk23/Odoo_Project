<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="cmcts_homepage_layout" inherit_id="website.layout" name="CMCTS Layout Assets">
        <xpath expr="//head" position="inside">
            <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&amp;display=swap" rel="stylesheet"/>
        </xpath>
    </template>

    <template id="cmcts_homepage" inherit_id="website.homepage" name="CMCTS Homepage SaaS">
        <xpath expr="//div[@id='wrap']" position="replace">
            
            <div id="wrap" class="oe_structure oe_empty">
                <!-- Hide default header and footer -->
                <t t-set="no_header" t-value="True"/>
                <t t-set="no_footer" t-value="True"/>
                
                <!-- Glassmorphism Navbar -->
                <nav class="cmcts-navbar">
                    <div class="container d-flex justify-content-between align-items-center">
                        <a href="/" class="d-flex align-items-center text-decoration-none">
                            <img src="/cmcts_website/static/src/img/cmcts_logo.png" alt="CMCTS Logo" class="cmcts-logo-img me-2"/>
                        </a>
                        <div>
                            <a href="#consulting-form" class="cmcts-nav-btn">Tư Vấn Ngay</a>
                        </div>
                    </div>
                </nav>

                <!-- Hero Section (Mesh Gradient + Typography) -->
                <section class="cmcts-hero">
                    <div class="cmcts-hero-mesh"></div>
                    <div class="container">
                        <div class="row justify-content-center">
                            <div class="col-lg-10 text-center">
                                <span class="cmcts-hero-badge">Odoo Enterprise Solution</span>
                                <h1>Xây Dựng Khung Gầm Vững Chắc<br/>Cho Doanh Nghiệp Số</h1>
                                <p class="lead">
                                    Nền tảng quản lý hợp nhất. Xóa bỏ ranh giới giữa Kho bãi và Chăm sóc khách hàng.
                                    Tự động hóa toàn diện quy trình với CMCTS ERP.
                                </p>
                                <a href="#consulting-form" class="cmcts-btn-primary mt-3">
                                    Bắt đầu chuyển đổi ngay
                                    <i class="fa fa-arrow-right ms-2"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Logo Cloud / Trusted By -->
                <section class="cmcts-logo-cloud">
                    <div class="cmcts-marquee">
                        <span class="cmcts-marquee-item"><i class="fa fa-amazon me-2"></i> Amazon</span>
                        <span class="cmcts-marquee-item"><i class="fa fa-google me-2"></i> Google</span>
                        <span class="cmcts-marquee-item"><i class="fa fa-microsoft me-2"></i> Microsoft</span>
                        <span class="cmcts-marquee-item"><i class="fa fa-apple me-2"></i> Apple</span>
                        <span class="cmcts-marquee-item"><i class="fa fa-spotify me-2"></i> Spotify</span>
                        <span class="cmcts-marquee-item"><i class="fa fa-stripe me-2"></i> Stripe</span>
                        
                        <!-- Duplicate for seamless loop -->
                        <span class="cmcts-marquee-item"><i class="fa fa-amazon me-2"></i> Amazon</span>
                        <span class="cmcts-marquee-item"><i class="fa fa-google me-2"></i> Google</span>
                        <span class="cmcts-marquee-item"><i class="fa fa-microsoft me-2"></i> Microsoft</span>
                        <span class="cmcts-marquee-item"><i class="fa fa-apple me-2"></i> Apple</span>
                        <span class="cmcts-marquee-item"><i class="fa fa-spotify me-2"></i> Spotify</span>
                        <span class="cmcts-marquee-item"><i class="fa fa-stripe me-2"></i> Stripe</span>
                    </div>
                </section>

                <!-- Features Zig-Zag Section -->
                <section class="cmcts-features-section">
                    <div class="container">
                        <!-- Feature 1 -->
                        <div class="row cmcts-feature-row">
                            <div class="col-lg-5 order-2 order-lg-1">
                                <div class="cmcts-feature-text">
                                    <h3>Chấm dứt kỉ nguyên "Nhớ nhớ quên quên"</h3>
                                    <p>Hệ thống tự động nhắc nhở và ép buộc quy trình. Bạn không cần phải lo lắng nhân sự quên thao tác hay nhập thiếu thông tin quan trọng.</p>
                                    <ul class="cmcts-feature-list">
                                        <li><i class="fa fa-check-circle"></i> Quét Barcode trực tiếp qua Mobile App</li>
                                        <li><i class="fa fa-check-circle"></i> Cảnh báo đỏ nếu xuất hàng sai kho</li>
                                        <li><i class="fa fa-check-circle"></i> Tự động đồng bộ số dư sang Kế toán</li>
                                    </ul>
                                </div>
                            </div>
                            <div class="col-lg-6 offset-lg-1 order-1 order-lg-2 mb-4 mb-lg-0">
                                <div class="cmcts-feature-img-wrapper">
                                    <div style="background: var(--background); border-radius: 8px; padding: 20px;">
                                        <div class="d-flex align-items-center mb-3">
                                            <i class="fa fa-exclamation-triangle text-danger me-3" style="font-size: 24px;"></i>
                                            <h5 class="mb-0 fw-bold text-danger">Lỗi Xác Thực (Validation Error)</h5>
                                        </div>
                                        <p class="text-muted mb-0">Sản phẩm "MacBook Pro M3" bắt buộc phải nhập Serial Number trước khi Xác nhận xuất kho!</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Feature 2 -->
                        <div class="row cmcts-feature-row">
                            <div class="col-lg-6 mb-4 mb-lg-0">
                                <div class="cmcts-feature-img-wrapper">
                                    <div class="d-flex mb-3 align-items-center">
                                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; margin-right: 15px;">
                                            <i class="fa fa-envelope"></i>
                                        </div>
                                        <div>
                                            <h6 class="mb-0 fw-bold">CMCTS CRM Bot</h6>
                                            <small class="text-muted">Vừa gửi tự động lúc 09:00 AM</small>
                                        </div>
                                    </div>
                                    <div style="background: var(--background); border-radius: 8px; padding: 15px; border-left: 4px solid var(--secondary);">
                                        <strong>Kính gửi Quý Khách,</strong><br/>
                                        Cảm ơn anh/chị đã quan tâm đến giải pháp ERP...
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-5 offset-lg-1">
                                <div class="cmcts-feature-text">
                                    <h3>Bán hàng tự động 24/7</h3>
                                    <p>Chuyển đổi phễu CRM thành một cỗ máy kiếm tiền. Chỉ cần chuyển trạng thái (Stage), kịch bản tự động sẽ được kích hoạt.</p>
                                    <ul class="cmcts-feature-list">
                                        <li><i class="fa fa-check-circle"></i> Tự động gửi Email/SMS chào mừng</li>
                                        <li><i class="fa fa-check-circle"></i> Nhắc lịch Telesale cho nhân viên</li>
                                        <li><i class="fa fa-check-circle"></i> Đánh giá tỉ lệ chốt deal (Win/Loss Ratio)</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Bento Grid Services Section -->
                <section class="cmcts-bento-section">
                    <div class="container">
                        <div class="row justify-content-center mb-5">
                            <div class="col-lg-8 text-center">
                                <h2 class="fw-bold" style="font-size: 2.5rem; letter-spacing: -0.02em; color: var(--primary);">Hệ sinh thái duy nhất<br/>mà bạn cần</h2>
                            </div>
                        </div>
                        
                        <!-- Bento Grid -->
                        <div class="row g-4">
                            <!-- Large Card 1 -->
                            <div class="col-lg-8">
                                <div class="cmcts-bento-card bento-large">
                                    <div class="cmcts-bento-icon">
                                        <i class="fa fa-qrcode"></i>
                                    </div>
                                    <h3 class="cmcts-bento-title">Kiểm soát Serial Number Tuyệt Đối</h3>
                                    <p class="cmcts-bento-desc w-75">
                                        Hệ thống bắt buộc truy xuất nguồn gốc từng sản phẩm. Chặn đứng lỗi sai lệch tồn kho với cơ chế xác thực Serial tự động trước khi xuất hàng.
                                    </p>
                                </div>
                            </div>
                            
                            <!-- Small Card 1 -->
                            <div class="col-lg-4">
                                <div class="cmcts-bento-card text-center d-flex flex-column align-items-center justify-content-center" style="background: var(--primary); color: white; border: none;">
                                    <i class="fa fa-bolt mb-3" style="font-size: 48px; color: #f59e0b;"></i>
                                    <h4 class="fw-bold mb-0">Tự Động Hóa 100%</h4>
                                </div>
                            </div>

                            <!-- Small Card 2 -->
                            <div class="col-lg-4">
                                <div class="cmcts-bento-card">
                                    <div class="cmcts-bento-icon" style="color: var(--accent);">
                                        <i class="fa fa-envelope-open-text"></i>
                                    </div>
                                    <h4 class="cmcts-bento-title">Email Báo Giá</h4>
                                    <p class="cmcts-bento-desc">
                                        Tự động gửi báo giá chuyên nghiệp ngay khi khách hàng bước vào giai đoạn đàm phán.
                                    </p>
                                </div>
                            </div>

                            <!-- Large Card 2 -->
                            <div class="col-lg-8">
                                <div class="cmcts-bento-card bento-large">
                                    <div class="cmcts-bento-icon" style="color: var(--secondary);">
                                        <i class="fa fa-users-cog"></i>
                                    </div>
                                    <h3 class="cmcts-bento-title">CRM Pipeline Tiên Tiến</h3>
                                    <p class="cmcts-bento-desc w-75">
                                        Thu thập Lead trực tiếp từ Website. Hệ thống tự động tạo Lịch nhắc nhở gọi điện (Activity) cho Sales Manager ngay khi có cơ hội mới.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Testimonials Section -->
                <section class="cmcts-testimonials">
                    <div class="container relative z-index-2">
                        <div class="row justify-content-center mb-5 text-center">
                            <div class="col-lg-8">
                                <h2 class="display-6 fw-bold mb-3">Sự lựa chọn của các doanh nghiệp dẫn đầu</h2>
                                <p style="color: #94a3b8;">Hàng ngàn giờ làm việc được tiết kiệm mỗi tháng.</p>
                            </div>
                        </div>
                        <div class="row g-4">
                            <div class="col-lg-4">
                                <div class="cmcts-review-card">
                                    <div class="cmcts-stars">
                                        <i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i>
                                    </div>
                                    <p class="cmcts-review-text">"Từ khi áp dụng tính năng ép nhập Serial của CMCTS, tỷ lệ sai lệch kho của chúng tôi giảm từ 15% xuống còn 0%. Thật sự ấn tượng!"</p>
                                    <h5 class="cmcts-reviewer-name">Nguyễn Hoàng Nam</h5>
                                    <span class="cmcts-reviewer-title">Giám đốc Vận hành, TechStoreVN</span>
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <div class="cmcts-review-card">
                                    <div class="cmcts-stars">
                                        <i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i>
                                    </div>
                                    <p class="cmcts-review-text">"Giao diện website cực kỳ mượt mà. Hệ thống tự động đẩy dữ liệu form vào thẳng CRM giúp team Sales liên hệ khách nhanh gấp 3 lần."</p>
                                    <h5 class="cmcts-reviewer-name">Trần Mai Anh</h5>
                                    <span class="cmcts-reviewer-title">Trưởng phòng Kinh doanh, AlphaCorp</span>
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <div class="cmcts-review-card">
                                    <div class="cmcts-stars">
                                        <i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i>
                                    </div>
                                    <p class="cmcts-review-text">"Hệ thống tự động hóa email báo giá hoạt động quá tuyệt. Chúng tôi không còn phải gõ tay từng email như trước đây nữa."</p>
                                    <h5 class="cmcts-reviewer-name">Lê Quang Hải</h5>
                                    <span class="cmcts-reviewer-title">CEO, Logistic Global</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Split Screen Form Section -->
                <section id="consulting-form" class="cmcts-split-section">
                    <div class="col-lg-5 cmcts-split-left">
                        <h2 class="display-5 fw-bold mb-4">Bạn đã sẵn sàng<br/>tăng tốc?</h2>
                        <p class="fs-5" style="color: #cbd5e1;">Liên hệ với chuyên gia của chúng tôi để được tư vấn lộ trình triển khai ERP hoàn toàn miễn phí.</p>
                        
                        <ul class="cmcts-trust-list">
                            <li><i class="fa fa-check-circle"></i> Triển khai nhanh gọn trong 2 tuần</li>
                            <li><i class="fa fa-check-circle"></i> Miễn phí tư vấn quy trình kho</li>
                            <li><i class="fa fa-check-circle"></i> Đội ngũ kỹ sư hỗ trợ 24/7</li>
                        </ul>
                    </div>
                    
                    <div class="col-lg-7 cmcts-split-right">
                        <div style="max-width: 500px; width: 100%; margin: 0 auto;">
                            <h3 class="fw-bold mb-4" style="color: var(--primary);">Đăng ký tư vấn</h3>
                            <form action="/tu-van" method="post" enctype="multipart/form-data">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                
                                <div class="row">
                                    <div class="col-md-6 cmcts-form-group">
                                        <label class="cmcts-form-label">Họ và Tên</label>
                                        <input type="text" class="cmcts-input" name="name" placeholder="Ví dụ: Nguyễn Văn A" required="required"/>
                                    </div>
                                    <div class="col-md-6 cmcts-form-group">
                                        <label class="cmcts-form-label">Số điện thoại</label>
                                        <input type="tel" class="cmcts-input" name="phone" placeholder="090 123 4567" required="required"/>
                                    </div>
                                </div>
                                
                                <div class="cmcts-form-group">
                                    <label class="cmcts-form-label">Email làm việc</label>
                                    <input type="email" class="cmcts-input" name="email" placeholder="email@congty.com" required="required"/>
                                </div>
                                
                                <div class="cmcts-form-group">
                                    <label class="cmcts-form-label">Nhu cầu triển khai</label>
                                    <textarea class="cmcts-input" name="description" placeholder="Vui lòng chia sẻ ngắn gọn về bài toán quản lý kho/bán hàng của bạn..." style="height: 120px; resize: none;"></textarea>
                                </div>
                                
                                <button type="submit" class="cmcts-btn-primary w-100">Gửi Yêu Cầu</button>
                                <p class="text-center text-muted mt-3" style="font-size: 13px;">Bằng cách gửi yêu cầu, bạn đồng ý với chính sách bảo mật của chúng tôi.</p>
                            </form>
                        </div>
                    </div>
                </section>

                <!-- Mega Footer -->
                <footer class="cmcts-footer">
                    <div class="container">
                        <div class="row">
                            <div class="col-lg-4 mb-4 mb-lg-0">
                                <img src="/cmcts_website/static/src/img/cmcts_logo.png" alt="CMCTS Logo" class="cmcts-footer-logo"/>
                                <p style="max-width: 300px;">Kiến tạo chuẩn mực mới trong quản trị doanh nghiệp số. Xây dựng giải pháp Odoo chuẩn quốc tế cho thị trường Việt Nam.</p>
                                <div class="mt-4">
                                    <a href="#" class="text-white me-3"><i class="fa fa-facebook-square fa-lg"></i></a>
                                    <a href="#" class="text-white me-3"><i class="fa fa-linkedin-square fa-lg"></i></a>
                                    <a href="#" class="text-white"><i class="fa fa-twitter-square fa-lg"></i></a>
                                </div>
                            </div>
                            <div class="col-lg-2 offset-lg-2 col-md-4 mb-4 mb-md-0">
                                <h5 class="cmcts-footer-heading">Sản phẩm</h5>
                                <ul class="cmcts-footer-links">
                                    <li><a href="#">Quản lý Kho (WMS)</a></li>
                                    <li><a href="#">Quản lý Khách hàng (CRM)</a></li>
                                    <li><a href="#">Landing Page SaaS</a></li>
                                    <li><a href="#">Báo cáo thông minh</a></li>
                                </ul>
                            </div>
                            <div class="col-lg-2 col-md-4 mb-4 mb-md-0">
                                <h5 class="cmcts-footer-heading">Công ty</h5>
                                <ul class="cmcts-footer-links">
                                    <li><a href="#">Về chúng tôi</a></li>
                                    <li><a href="#">Tuyển dụng</a></li>
                                    <li><a href="#">Tin tức</a></li>
                                    <li><a href="#">Bảo mật</a></li>
                                </ul>
                            </div>
                            <div class="col-lg-2 col-md-4">
                                <h5 class="cmcts-footer-heading">Liên hệ</h5>
                                <ul class="cmcts-footer-links">
                                    <li><i class="fa fa-map-marker me-2"></i> Hà Nội, VN</li>
                                    <li><i class="fa fa-phone me-2"></i> 1900 8888</li>
                                    <li><i class="fa fa-envelope me-2"></i> hello@cmcts.vn</li>
                                </ul>
                            </div>
                        </div>
                        <div class="cmcts-footer-bottom">
                            <div>© 2026 CMCTS Technology. All rights reserved.</div>
                            <div>
                                <a href="#" class="text-muted me-3">Privacy Policy</a>
                                <a href="#" class="text-muted">Terms of Service</a>
                            </div>
                        </div>
                    </div>
                </footer>

            </div>
        </xpath>
    </template>
</odoo>
