<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="thank_you_page" name="Thank You">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <section class="py-5" style="min-height: 70vh; display: flex; align-items: center; background-color: #f8fafc;">
                    <div class="container">
                        <div class="row justify-content-center">
                            <div class="col-md-8 text-center">
                                <div class="card border-0 shadow-lg" style="border-radius: 20px;">
                                    <div class="card-body p-5">
                                        <div class="mb-4 text-success">
                                            <i class="fa fa-check-circle" style="font-size: 80px;"></i>
                                        </div>
                                        <h1 class="display-5 fw-bold mb-3" style="color: #0f172a;">Cảm ơn <t t-esc="customer_name"/>!</h1>
                                        <p class="lead text-muted mb-5">
                                            Yêu cầu tư vấn của bạn đã được gửi thành công. Chuyên viên của CMCTS sẽ liên hệ lại với bạn qua số điện thoại hoặc email trong thời gian sớm nhất (tối đa 24h làm việc).
                                        </p>
                                        <a href="/" class="btn btn-lg" style="background-color: #3b82f6; color: white; border-radius: 10px; padding: 12px 30px; font-weight: 600;">
                                            <i class="fa fa-home me-2"></i> Quay lại trang chủ
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>
</odoo>
