<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Override the main products page đến add a Hero Banner -->
    <template id="cmcts_products_hero" inherit_id="website_sale.products" name="CMCTS Shop Hero">
        <xpath expr="//div[hasclass('oe_website_sale')]" position="before">
            <section class="cmcts-shop-hero">
                <div class="container text-center">
                    <h1 class="fw-bold mb-3">Danh mục Giải pháp &amp; Thiết bị</h1>
                    <p class="text-light opacity-75 mx-auto" style="max-width: 700px;">
                        Cung cấp phần cứng, phần mềm và giải pháp công nghệ thông tin chuyên dụng dành cho Doanh nghiệp và Tổ chức.
                    </p>
                </div>
            </section>
        </xpath>
    </template>

    <!-- 2. Override the individual product card (products_item) -->
    <template id="cmcts_products_item" inherit_id="website_sale.products_item" name="CMCTS Product Item">
        <!-- Add a wrapper class đến the main card for styling -->
        <xpath expr="//div[hasclass('oe_product_image')]" position="attributes">
            <attribute name="class">card-body p-1 oe_product_image cmcts-product-image-wrapper</attribute>
        </xpath>
        
        <!-- Style the info section -->
        <xpath expr="//div[hasclass('o_wsale_product_information')]" position="attributes">
            <attribute name="class">card-body p-4 o_wsale_product_information cmcts-product-info</attribute>
        </xpath>
        
        <!-- Replace Add đến Cart / Price with a minimalist B2B look -->
        <xpath expr="//div[hasclass('product_price')]" position="attributes">
            <attribute name="class" add="mt-3" separator=" "/>
        </xpath>
    </template>
</odoo>
