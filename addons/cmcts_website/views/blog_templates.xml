<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="cmcts_blog_hero" inherit_id="website_blog.index" name="CMCTS Blog Hero" priority="99">
        <xpath expr="//div[@id='wrap']" position="before">
            <section class="cmcts-blog-hero text-center text-white py-5 w-100" style="max-width: 100%;">
                <div class="container py-5">
                    <h1 class="fw-bold mb-3">Tin Tức &amp; Chuyên Trang</h1>
                    <p class="text-light opacity-75 mx-auto" style="max-width: 700px;">
                        Cập nhật tin tức, xu hướng công nghệ và những câu chuyện chuyển đổi số thành công từ các chuyên gia CMC TS.
                    </p>
                </div>
            </section>
        </xpath>
        <xpath expr="//div[@id='wrap']" position="attributes">
            <attribute name="class" separator=" " add="cmcts-blog-wrap"/>
        </xpath>
    </template>
</odoo>
