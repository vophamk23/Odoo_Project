<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Course Form View -->
    <record id="view_course_form" model="ir.ui.view">
        <field name="name">course.form</field>
        <field name="model">student.course</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Ví dụ: Lập trình Python"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="credits"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Sinh viên tham gia">
                            <field name="student_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Course List View -->
    <record id="view_course_list" model="ir.ui.view">
        <field name="name">course.list</field>
        <field name="model">student.course</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code"/>
                <field name="name"/>
                <field name="credits"/>
            </tree>
        </field>
    </record>

    <!-- Course Action -->
    <record id="action_course" model="ir.actions.act_window">
        <field name="name">Khóa học</field>
        <field name="res_model">student.course</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu Khóa học (Nằm dưới menu Sinh viên gốc) -->
    <menuitem id="menu_course_list" name="Khóa học"
              parent="menu_student_root" action="action_course" sequence="20"/>
</odoo>
