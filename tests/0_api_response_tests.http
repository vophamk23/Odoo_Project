# ==============================================================================
# NHÓM 7: KIỂM THỬ PHẢN HỒI API (API RESPONSE TESTS)
# Mục đích: Kiểm tra từng trường hợp 200/400/401 của tất cả API endpoints
#
# DANH SÁCH API:
# ┌─────┬──────────────────────────────────────┬────────┬──────────────────────────────────────────────┐
# │  #  │ Tên API                              │ Method │ Route                                        │
# ├─────┼──────────────────────────────────────┼────────┼──────────────────────────────────────────────┤
# │  1  │ Auth Token (Lấy / Làm mới token)     │  POST  │ /auth/token                                  │
# │  2  │ Controller Register (Đăng ký ctrl)   │  POST  │ /api/v1/ControllerRegister                   │
# │  3  │ Controller Heartbeat (Nhịp tim)      │  POST  │ /api/v1/ControllerHeartbeat                  │
# │ 3ES │ Employee Sync (Đồng bộ NV)           │  POST  │ /api/v1/ControllerEmployeeSync                 │
# │  4  │ Access Log Upload (Gửi log vào/ra)   │  POST  │ /api/v1/AccessLogUpload                      │
# │  5  │ Device Register (Đăng ký thiết bị)   │  POST  │ /api/v1/DeviceRegister                       │
# │  6  │ Controller Employee Sync Status      │  GET   │ /api/v1/ControllerEmployeeSyncStatus         │
# │  7  │ Employee Biometric Get (Lấy biomet.) │  POST  │ /api/v1/EmployeeBiometricGet                 │
# │  8  │ Controller Get Config (Lấy cấu hình) │  POST  │ /api/v1/ControllerGetConfig                  │
# └─────┴──────────────────────────────────────┴────────┴──────────────────────────────────────────────┘
#
# LUỒNG TÍCH HỢP ĐIỂN HÌNH:
#
#   [KHỞI ĐỘNG]
#       │
#       ▼
#   API 1 ── Lấy Access Token (client_credentials)
#       │
#       ▼
#   API 2 ── Đăng ký Controller (ControllerRegister)
#       │
#       ▼
#   API 5 ── Đăng ký các Device thuộc Controller (DeviceRegister)
#       │
#       ▼
#   API 8 ── Lấy cấu hình đầy đủ của Controller (ControllerGetConfig)
#       │
#       ▼
#   API 6 ── Kiểm tra có cần đồng bộ nhân viên không? (SyncStatus)
#       │
#       ├── update = false ──► [Không cần sync, bỏ qua]
#       │
#       └── update = true ───▼
#   API 3ES ─ Lấy danh sách nhân viên cần sync (ControllerEmployeeSync)
#       │
#       ▼
#   API 7 ── Lấy biometric từng nhân viên (EmployeeBiometricGet)
#       │
#   [HOẠT ĐỘNG ĐỊNH KỲ]
#       │
#       ▼
#   API 3 ── Gửi Heartbeat định kỳ (ControllerHeartbeat)
#       │
#       ▼
#   API 4 ── Gửi log chấm công lên server (AccessLogUpload)
#       │
#       ▼
#   API 1 ── Làm mới token trước khi hết hạn (refresh_token)
#
# MÃ LỖI CHUNG:
#   200 — Thành công
#   400 — Bad Request (thiếu field, sai dữ liệu)
#   401 — Unauthorized (thiếu/sai/hết hạn token)
#   403 — Forbidden (IP không được phép) — chỉ API 1
#   429 — Too Many Requests (rate limit) — chỉ API 1
# ==============================================================================

# ------------------------------------------------------------------------------
# CHỨC NĂNG: Đăng nhập lấy token để dùng cho các test bên dưới.
# ------------------------------------------------------------------------------
# @name login
POST http://localhost:8070/auth/token
Content-Type: application/json

{
    "client_id": "app_637da3fbc1a6e3e1430a12be2c5e51e4",
    "client_secret": "Puuf11KY4a6UMhbMW4e6V26ko5CDQzhn4KrVQPnVetU",
    "grant_type": "client_credentials"
}


# ==============================================================================
# API 1: AUTH TOKEN
# ==============================================================================

### 1.A 200 - Đăng nhập thành công với client_credentials
# KẾT QUẢ: {"status": "success", "api_token": {...}, "refresh_token": {...}}
POST http://localhost:8070/auth/token
Content-Type: application/json

{
    "client_id": "app_637da3fbc1a6e3e1430a12be2c5e51e4",
    "client_secret": "Puuf11KY4a6UMhbMW4e6V26ko5CDQzhn4KrVQPnVetU",
    "grant_type": "client_credentials"
}

### 1.B 200 - Làm mới token bằng refresh_token
# KẾT QUẢ: {"status": "success", "api_token": {...}, "refresh_token": {...}}
POST http://localhost:8070/auth/token
Content-Type: application/json

{
    "client_id": "app_637da3fbc1a6e3e1430a12be2c5e51e4",
    "client_secret": "Puuf11KY4a6UMhbMW4e6V26ko5CDQzhn4KrVQPnVetU",
    "grant_type": "refresh_token",
    "refresh_token": "REPLACE_WITH_ACTUAL_REFRESH_TOKEN"
}

### 1.C 400 - Body JSON không hợp lệ (malformed JSON)
# KẾT QUẢ: {"status": "error", "message": "Invalid JSON body."}
POST http://localhost:8070/auth/token
Content-Type: application/json

NOT_VALID_JSON

### 1.D 400 - Thiếu refresh_token khi grant_type = refresh_token
# KẾT QUẢ: {"status": "error", "message": "refresh_token is required."}
POST http://localhost:8070/auth/token
Content-Type: application/json

{
    "client_id": "app_637da3fbc1a6e3e1430a12be2c5e51e4",
    "client_secret": "Puuf11KY4a6UMhbMW4e6V26ko5CDQzhn4KrVQPnVetU",
    "grant_type": "refresh_token"
}

### 1.E 401 - client_id không tồn tại
# KẾT QUẢ: {"error": "invalid_client", "message": "..."}
POST http://localhost:8070/auth/token
Content-Type: application/json

{
    "client_id": "app_FAKE_DOES_NOT_EXIST",
    "client_secret": "Puuf11KY4a6UMhbMW4e6V26ko5CDQzhn4KrVQPnVetU",
    "grant_type": "client_credentials"
}

### 1.F 401 - client_secret sai
# KẾT QUẢ: {"error": "invalid_client", "message": "..."}
POST http://localhost:8070/auth/token
Content-Type: application/json

{
    "client_id": "app_637da3fbc1a6e3e1430a12be2c5e51e4",
    "client_secret": "WRONG_SECRET_HERE",
    "grant_type": "client_credentials"
}

### 1.G 401 - Thiếu client_secret
# KẾT QUẢ: {"error": "invalid_request", "message": "client_secret is required."}
POST http://localhost:8070/auth/token
Content-Type: application/json

{
    "client_id": "app_637da3fbc1a6e3e1430a12be2c5e51e4",
    "grant_type": "client_credentials"
}

### 1.H 401 - refresh_token hết hạn hoặc không hợp lệ
# KẾT QUẢ: {"error": "invalid_grant", "message": "Invalid or expired refresh_token..."}
POST http://localhost:8070/auth/token
Content-Type: application/json

{
    "client_id": "app_637da3fbc1a6e3e1430a12be2c5e51e4",
    "client_secret": "Puuf11KY4a6UMhbMW4e6V26ko5CDQzhn4KrVQPnVetU",
    "grant_type": "refresh_token",
    "refresh_token": "EXPIRED_OR_INVALID_TOKEN"
}

### 1.I 401 - Thiếu client_id khi grant_type = client_credentials
# KẾT QUẢ: {"status": "error", "message": "client_id is required."}
POST http://localhost:8070/auth/token
Content-Type: application/json

{
    "client_secret": "Puuf11KY4a6UMhbMW4e6V26ko5CDQzhn4KrVQPnVetU",
    "grant_type": "client_credentials"
}

### 1.J 200 - Thiếu grant_type
# KẾT QUẢ: {"status": "success", "message": "Authentication successful."}
POST http://localhost:8070/auth/token
Content-Type: application/json

{
    "client_id": "app_637da3fbc1a6e3e1430a12be2c5e51e4",
    "client_secret": "Puuf11KY4a6UMhbMW4e6V26ko5CDQzhn4KrVQPnVetU"
}


