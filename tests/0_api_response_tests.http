Authorization: Bearer FAKE_TOKEN_XYZ_123
Content-Type: application/json

{
    "devices": [
        {
            "serial_number": "DEV-HN-MAIN-01",
            "controller_sn": "CTRL-HN-LOBBY-01"
        }
    ]
}

