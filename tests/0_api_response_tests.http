### 2.A 200 - Đăng ký controller thành công (đầy đủ fields)
# KẾT QUẢ: {"message": "Controller registered successfully", "data": {"id": "..."}}
# Ý NGHĨA CÁC TRƯỜNG THỜI GIAN:
#   - installed_at: Ngày cài đặt/lắp đặt thiết bị vật lý tại thực tế.
POST http://localhost:8070/api/v1/ControllerRegister
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "name": "Controller Sảnh Hà Nội",
    "serial_number": "CTRL-HN-LOBBY-01",
    "branch_code": "HnMain",
    "hardware_model": "T4-GATE-PRO",
    "firmware_version": "v2.1.0",
    "ip_address": "192.168.10.210",
    "mac_address": "00:17:0A:11:22:33",
    "connection_type": "tcp_ip",
    "installed_at": "2026-07-14"
}

