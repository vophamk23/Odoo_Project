Authorization: Bearer {{token}}
Content-Type: application/json

{
    "controller_sn": "CTRL-HN-LOBBY-01",
    "devices": [
        {"device_sn": "DEV-HN-LOB-IN-01", "status": "online"},
        {"device_sn": "DEV-HN-LOB-OUT-01", "status": "offline"}
    ]
}

