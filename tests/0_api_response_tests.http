POST http://localhost:8070/api/v1/DeviceRegister
Content-Type: application/json

{
    "devices": [
        {
            "serial_number": "DEV-HN-MAIN-01",
            "controller_sn": "CTRL-HN-LOBBY-01"
        }
    ]
}

