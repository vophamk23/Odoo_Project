# ==============================================================================
# API 5: DEVICE REGISTER
# ==============================================================================

### 5.A 200 - Đăng ký thiết bị thành công (đầy đủ fields)
# KẾT QUẢ: {"message": "Devices register successfully", "data": {"id": "..."}}
# Ý NGHĨA CÁC TRƯỜNG THỜI GIAN:
#   - last_heartbeat: Thời điểm cuối cùng thiết bị vật lý ping/giao tiếp với controller.
#   - installed_at: Ngày lắp đặt thiết bị vật lý tại thực tế.
#   - last_sync_at: Thời điểm đồng bộ dữ liệu cuối cùng của thiết bị.
POST http://localhost:8070/api/v1/DeviceRegister
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "devices": [
        {
            "name": "Đầu đọc cổng chính",
            "serial_number": "DEV-HN-MAIN-01",
            "controller_sn": "CTRL-HN-LOBBY-01",
            "vendor": "ZKTeco",
            "firmware_version": "v1.5.0",
            "system_version": "Linux 5.10",
            "port_or_channel": "1",
            "last_heartbeat": "2026-07-14 08:00:00",
            "installed_at": "2026-07-14 00:00:00",
            "last_sync_at": "2026-07-14 08:00:00"
        }
    ]
}

