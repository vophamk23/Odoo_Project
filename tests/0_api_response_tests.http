# ==============================================================================
# API 3ES: EMPLOYEE SYNC
# ==============================================================================

### 3_ES.A 200 - Đồng bộ thành công, có nhân viên mới/cập nhật/xóa (mặc định page_size=15)
# KẾT QUẢ: {"message": "Employee sync completed", "data": {"data": {"next_cursor_id": ..., "has_next_page": ..., "new": [...], "update": [...], "deleted": [...]}}}
POST http://localhost:8070/api/v1/ControllerEmployeeSync
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "controller_sn": "CTRL-HN-LOBBY-01"
}

### 3_ES.B 200 - Đồng bộ thành công, không có thay đổi (tất cả mảng rỗng)
# KẾT QUẢ: {"message": "Employee sync completed", "data": [{"new": [], "update": [], "deleted": []}]}
POST http://localhost:8070/api/v1/ControllerEmployeeSync
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "controller_sn": "CTRL-HN-LOBBY-01"
}

### 3_ES.C 400 - Thiếu controller_sn
# KẾT QUẢ: {"success": false, "message": "Controller ID is required."}
POST http://localhost:8070/api/v1/ControllerEmployeeSync
Authorization: Bearer {{token}}
Content-Type: application/json

{}

### 3_ES.D 400 - controller_sn không tồn tại
# KẾT QUẢ: {"success": false, "message": "Can not find controller with ID CTRL-FAKE-999"}
POST http://localhost:8070/api/v1/ControllerEmployeeSync
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "controller_sn": "CTRL-FAKE-999"
}

### 3_ES.E 401 - Không có token
POST http://localhost:8070/api/v1/ControllerEmployeeSync
Content-Type: application/json

{
    "controller_sn": "CTRL-HN-LOBBY-01"
}

### 3_ES.F 401 - Token sai / hết hạn
POST http://localhost:8070/api/v1/ControllerEmployeeSync
Authorization: Bearer INVALID_TOKEN_XYZ
Content-Type: application/json

{
    "controller_sn": "CTRL-HN-LOBBY-01"
}

### 3_ES.G 200 - Đồng bộ thành công, phân trang trang 1 (page_size = 2)
# KẾT QUẢ: Trả về tối đa 2 nhân viên trong mảng "new", kèm theo "next_cursor_id" và "has_next_page": true
POST http://localhost:8070/api/v1/ControllerEmployeeSync
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "controller_sn": "CTRL-HN-LOBBY-01",
    "page_size": 2
}

### 3_ES.H 200 - Đồng bộ thành công, phân trang trang 2 với Cursor (page_size = 2)
# KẾT QUẢ: Trả về trang tiếp theo của danh sách nhân viên bằng con trỏ next_cursor_id
POST http://localhost:8070/api/v1/ControllerEmployeeSync
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "controller_sn": "CTRL-HN-LOBBY-01",
    "page_size": 2,
    "next_cursor_id": 2,
    "latest_write_date": "2026-08-05 08:00:00"
}

### 3_ES.I 200 - Đồng bộ kết hợp mốc last_sync_at Delta và Cursor phân trang trang 2
# KẾT QUẢ: {"message": "Employee sync completed"}
POST http://localhost:8070/api/v1/ControllerEmployeeSync
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "controller_sn": "CTRL-HN-LOBBY-01",
    "page_size": 15,
    "last_sync_at": "2026-08-01 00:00:00",
    "next_cursor_id": 5,
    "latest_write_date": "2026-08-05 10:00:00"
}


# ==============================================================================
# API 3_ACK: CONTROLLER SYNC ACK
# ==============================================================================

### 3_ACK.A 200 - Xác nhận đồng bộ thành công (có truyền sync_timestamp)
# KẾT QUẢ: {"message": "Success", "data": {"status": "200 OK"}}
POST http://localhost:8070/api/v1/ControllerSyncAck
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "controller_sn": "CTRL-HN-LOBBY-01",
    "sync_timestamp": "2026-07-15 02:00:00"
}

### 3_ACK.B 200 - Xác nhận đồng bộ thành công (không truyền sync_timestamp → tự lấy giờ hiện tại)
# KẾT QUẢ: {"message": "Success", "data": {"status": "200 OK"}}
POST http://localhost:8070/api/v1/ControllerSyncAck
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "controller_sn": "CTRL-HN-LOBBY-01"
}

### 3_ACK.C 400 - Thiếu controller_sn
# KẾT QUẢ: {"success": false, "message": "Controller serial number is required."}
POST http://localhost:8070/api/v1/ControllerSyncAck
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "sync_timestamp": "2026-07-15 02:00:00"
}

### 3_ACK.D 400 - controller_sn không tồn tại
# KẾT QUẢ: {"success": false, "message": "Can not find controller serial number với serial: CTRL-FAKE-999"}
POST http://localhost:8070/api/v1/ControllerSyncAck
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "controller_sn": "CTRL-FAKE-999"
}

### 3_ACK.E 401 - Không có token
POST http://localhost:8070/api/v1/ControllerSyncAck
Content-Type: application/json

{
    "controller_sn": "CTRL-HN-LOBBY-01"
}

### 3_ACK.F 500 - Sai định dạng sync_timestamp
# KẾT QUẢ: {"status": "error", "message": "ValueError"}
